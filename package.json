{
  "name": "@vindecodervehicle/sdk",
  "version": "1.0.0",
  "description": "Official Node.js SDK for the VIN Decoder Vehicle API",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": ["vin", "vin-decoder", "vehicle", "automotive", "api", "sdk", "nodejs"],
  "author": "VIN Decoder Vehicle",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JoxMarkes/vindecodervehicle-node-sdk.git"
  },
  "homepage": "https://vindecodervehicle.com",
  "bugs": {
    "url": "https://github.com/JoxMarkes/vindecodervehicle-node-sdk/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2"
  }
}